# === Environment ===
# development | production
ENVIRONMENT=development

# === Auth ===
SECRET_KEY=dev-secret-key-change-in-production
# Segredo compartilhado dos webhooks n8n -> backend (header X-Webhook-Secret).
# O MESMO valor precisa estar no .env do backend e no container do n8n.
WEBHOOK_SECRET=

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === LLM Provider ===
# ollama | openai
LLM_PROVIDER=ollama

# === OpenAI (usado apenas se LLM_PROVIDER=openai) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === Ollama (usado se LLM_PROVIDER=ollama ou OPENAI_API_KEY vazio) ===
# Dev: Ollama do host via host.docker.internal (backend roda em container).
# Prod: omita a variável — o compose prod injeta http://ollama:11434
# (serviço da própria pilha). Copiar este valor para o .env.prod quebra o LLM.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Modelo de chat (requer: ollama pull llama3.2)
# Para Ollama Cloud use, por exemplo: gpt-oss:120b-cloud
OLLAMA_MODEL=llama3.2
# Modelo de embedding (requer: ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text

# === PostgreSQL ===
# Usada pelo compose de produção (serviço postgres) e pela URI da Evolution.
# Gere uma senha forte e não a versione.
POSTGRES_PASSWORD=troque-esta-senha

# === Evolution API (WhatsApp) ===
# URL do servidor Evolution API
EVOLUTION_API_URL=http://localhost:8080
# Chave de autenticação global (mude em produção)
EVOLUTION_API_KEY=evolution_dev_key
# URL padrão do webhook n8n usada em POST /evolution/instance/webhook/default/{instancia}.
# Em produção, aponte para a URL interna da rede do compose: http://n8n:5678/webhook/emsoft-whatsapp
EVOLUTION_DEFAULT_WEBHOOK_URL=http://n8n:5678/webhook/emsoft-whatsapp
# Instância Evolution usada pelo backend para enviar mensagens (CSAT).
# Deve coincidir com EVOLUTION_INSTANCE (nó n8n "Enviar texto").
EVOLUTION_INSTANCE_NAME=emsoft-support
# Spec 00/00-11: liga o pedido automático de avaliação ao encerrar o chamado.
CSAT_ENABLED=false

# === Appwrite (endpoint, project e api_key) ===
# Dev: stack em infra/appwrite (porta 8020 do host); o compose dev aponta o
# backend para http://host.docker.internal:8020/v1.
# Prod: o compose prod anexa o backend à rede compartilhada "appwrite"
# (default: http://appwrite:80/v1, container Appwrite na porta 80 interna).
# Em produção, omita APPWRITE_ENDPOINT; este valor abaixo é só para dev.
APPWRITE_ENDPOINT=http://127.0.0.1:8020/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# === CORS ===
# Lista JSON exigida pelo pydantic-settings (string plain quebra o boot do backend).
# Produção: ["https://app.emsoft.app"] (default já definido no compose prod).
CORS_ORIGINS=["http://localhost:3000"]

# === n8n ===
N8N_PROTOCOL=http
N8N_HOST=localhost
# Permite {{ $env.* }} nos nós (WEBHOOK_SECRET, BACKEND_URL, EVOLUTION_INSTANCE).
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Chave de criptografia das credenciais do n8n (gere: openssl rand -hex 32).
N8N_ENCRYPTION_KEY=
# Nome da instância Evolution usada pelo nó "Enviar texto".
EVOLUTION_INSTANCE=emsoft-support
# URL base do backend, vista do container do n8n (rede interna do compose).
BACKEND_URL=http://backend:8000

# === Emsoft chamados (spec 11) ===
# Integração com a API de chamados Emsoft (docs/specs/11-integracao-api-emsoft.md).
# Nasce desabilitada: o backend só monta o serviço com enabled=true, contrato
# validado e token configurados JUNTOS.
EMSOFT_CHAMADOS_ENABLED=false
# Token da API (Bearer). Nunca commitar nem imprimir; manter no .env real.
EMSOFT_CHAMADOS_TOKEN=
# Artefato de contrato validado (spec 11 §Gate); dentro da imagem em /app.
EMSOFT_CHAMADOS_CONTRACT_FILE=/app/contracts/emsoft-chamados.json
# Usuário Emsoft da IA (campo 'usuario' de GET /v1/usuarios, ex.: gabriel.emsoft).
EMSOFT_CHAMADOS_AI_USER_ID=
# Timeout das chamadas à API, em segundos.
EMSOFT_CHAMADOS_TIMEOUT_S=15
# Nunca false em produção (guard no boot, validate_production_secrets).
EMSOFT_CHAMADOS_VERIFY_TLS=true
# Bundle de CAs alternativo (PEM); precede VERIFY_TLS. Resolve a cadeia
# incompleta do servidor Emsoft (detalhes em backend/certs/README.md).
EMSOFT_CHAMADOS_CA_BUNDLE=/app/certs/emsoft-ca-bundle.pem

# === HTTP (resiliência, 08-11) ===
# Timeout padrão das integrações HTTP externas, em segundos.
HTTP_TIMEOUT_S=30
# Total de tentativas em falha transitória (transporte e 429/5xx); inclui a 1ª.
HTTP_MAX_TENTATIVAS=3
# Backoff exponencial: espera ~base * 2**n com jitter de ±25%, limitado a máx.
HTTP_BACKOFF_BASE_S=0.5
HTTP_BACKOFF_MAX_S=8

# === Observabilidade (métricas, 08-6) ===
# Token Bearer exigido em GET /metrics. Vazio = sem auth (rota aberta, dev).
METRICAS_TOKEN=

# === Frontend (containers) ===
# Porta exposta no host (3000 pode estar ocupada por outros projetos).
FRONTEND_PORT=3000
# Injetados no build do Next.js; valores vistos pelo navegador (host).
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001
