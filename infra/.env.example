# === Environment ===
# development | production
ENVIRONMENT=development

# === Auth ===
SECRET_KEY=dev-secret-key-change-in-production
# Segredo compartilhado dos webhooks n8n -> backend (header X-Webhook-Secret).
# O MESMO valor precisa estar no .env do backend e no container do n8n.
WEBHOOK_SECRET=

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === LLM Provider ===
# ollama | openai
LLM_PROVIDER=ollama

# === OpenAI (usado apenas se LLM_PROVIDER=openai) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === Ollama (usado se LLM_PROVIDER=ollama ou OPENAI_API_KEY vazio) ===
# URL do servidor Ollama (padrão http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Modelo de chat (requer: ollama pull llama3.2)
OLLAMA_MODEL=deepseek-v4-flash:cloud
# Modelo de embedding (requer: ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text

# === Evolution API (WhatsApp) ===
# URL do servidor Evolution API
EVOLUTION_API_URL=http://localhost:8080
# Chave de autenticação global (mude em produção)
EVOLUTION_API_KEY=evolution_dev_key

# === Appwrite (endpoint, project e api_key) ===
# A stack do Appwrite sobe em infra/appwrite (porta 8020). O backend consome via SDK.
APPWRITE_ENDPOINT=http://127.0.0.1:8020/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# === CORS ===
CORS_ORIGINS=http://localhost:3000

# === n8n ===
N8N_PROTOCOL=http
N8N_HOST=localhost
