# Appwrite self-hosted configuration
_APP_ENV=development

# Porta HTTP do traefik do Appwrite (evita conflito com :80 da infra principal)
_APP_HTTP_PORT=8020

# Domínio / endpoint
_APP_DOMAIN=localhost
_APP_CONSOLE_DOMAIN=

# Banco de dados (Postgres interno do Appwrite)
_APP_DB_ADAPTER=postgresql
_APP_DB_HOST=postgresql
_APP_DB_PORT=5432
_APP_DB_SCHEMA=appwrite
_APP_DB_USER=appwrite
_APP_DB_PASS=<gere com openssl rand -hex 32>
# Senha do superuser (root) do Postgres, usada pelas migrations do Appwrite
_APP_DB_ROOT_PASS=<gere com openssl rand -hex 16>

# Redis interno (o compose sobe sem senha, por isso user/pass vazios)
_APP_REDIS_HOST=redis
_APP_REDIS_PORT=6379
_APP_REDIS_USER=
_APP_REDIS_PASS=

# Segredos de criptografia (gere com: openssl rand -hex 32)
_APP_OPENSSL_KEY_V1=55d41822ff2a44730a1c53c4fa572b87d275729a2c868da824262164993d418e
_APP_EXECUTOR_SECRET=<gere com openssl rand -hex 32>

# Storage local
_APP_STORAGE_DEVICE=Local
_APP_STORAGE_LIMIT=52428800000
_APP_STORAGE_PREVIEW_LIMIT=1024000

# Workers
_APP_WORKERS_NUM=1
_APP_WORKER_PER_CORE=8

# Executor
_APP_EXECUTOR_HOST=localhost

# Telemetria
_APP_USAGE_STATS=disabled
