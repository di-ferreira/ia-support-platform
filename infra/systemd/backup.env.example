# emsoft-backup.env — configuração do backup agendado (emsoft-backup.service).
#
# Copiado para ~/.config/emsoft-backup.env por scripts/install-backup-timer.sh
# (só se ainda não existir). Edite à vontade; o serviço lê via
# EnvironmentFile=-%h/.config/emsoft-backup.env (arquivo opcional: sem ele,
# os defaults de scripts/backup.sh valem). Se segredos/diretórios sensíveis
# entrarem aqui, mantenha o arquivo fora do repo e com permissão 600.

# Diretório dos artefatos de backup (relativo ao repo ou absoluto).
BACKUP_DIR=./backups

# Dias de retenção de artefatos.
BACKUP_RETENTION_DAYS=14

# Compose principal da stack.
COMPOSE_FILE=infra/docker-compose.prod.yml

# Contexto Docker, se a máquina usa um DOCKER_CONFIG fora do default
# (o backup roda sem TTY/sessão login; o socket precisa estar acessível
# ao usuário, ex.: membership no grupo docker).
#DOCKER_CONFIG=/home/USUARIO/.config/docker
