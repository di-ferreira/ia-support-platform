# Backend — FastAPI (app/core/config.py)
# Copie para backend/.env e preencha. Segredos NUNCA devem ser commitados.

# === Environment ===
# development | production
ENVIRONMENT=development
# Em produção, desligar (DEBUG=false)
DEBUG=true

# === Auth ===
# OBRIGATÓRIO em produção (fail-fast no startup). Gere: openssl rand -base64 32
SECRET_KEY=change-me-in-production
# Segredo compartilhado dos webhooks n8n -> backend (header X-Webhook-Secret).
# O MESMO valor precisa estar no serviço n8n (env WEBHOOK_SECRET). Fail-closed se ausente.
WEBHOOK_SECRET=

# === Tokens ===
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Qdrant (RAG semântico) ===
QDRANT_URL=http://localhost:6333

# === LLM Provider ===
# ollama | openai
LLM_PROVIDER=ollama

# === OpenAI (usado apenas se LLM_PROVIDER=openai) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === Ollama (padrão) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# === Evolution API (WhatsApp) ===
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=

# === IA ===
IA_NAME=EMSoft IA

# === CORS ===
# Lista JSON. Em dev, ["*"] é aceitável (auth por Bearer token, não por cookie).
# Em produção, use origens explícitas: ["https://app.emsoft.app"]
CORS_ORIGINS=["*"]

# === Appwrite (fonte de dados) ===
# Preencha APPWRITE_PROJECT_ID / APPWRITE_API_KEY após criar o project e a
# API key (papel Database) no console: http://localhost:8020
APPWRITE_ENDPOINT=http://127.0.0.1:8020/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
